# Base URL of the PawSome FastAPI backend (see ../backend).
#
# Prefer 127.0.0.1 over localhost in development. On Windows "localhost"
# resolves to ::1 before 127.0.0.1, and if the backend binds IPv4 only, every
# new connection waits for the IPv6 attempt to be refused first — measured at
# ~2s per connection, paid by each WebSocket and any request that can't reuse
# a keep-alive connection.
VITE_API_URL=http://127.0.0.1:8000

# WebSocket origin for real-time chat (usually the same host as VITE_API_URL)
VITE_WS_URL=ws://127.0.0.1:8000
